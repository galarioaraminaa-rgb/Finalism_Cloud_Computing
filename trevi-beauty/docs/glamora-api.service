[Unit]
Description=Glamora FastAPI Backend
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/glamora/backend
EnvironmentFile=/var/www/glamora/backend/.env
ExecStart=/var/www/glamora/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=glamora-api

[Install]
WantedBy=multi-user.target
